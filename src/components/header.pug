header.header
  .container.header__inner
    a.logo(href="#top")
      span.logo__badge(aria-hidden="true") K
      | eepsake

    nav.header__nav(aria-label="Основна навігація")
      +nav-links(navItems, 'header')

    a.favourites(href="#" aria-label="Обране")
      +icon('heart', 16)

    details.menu
      summary.menu__toggle(aria-label="Меню")
        +icon('burger', 22)(class="menu__icon-burger")
        +icon('close', 22)(class="menu__icon-close")

      nav.menu__panel(aria-label="Мобільне меню")
        +nav-links(navItems, 'menu')

        .menu__actions
          +btn('Contact us', '#cta')
          +btn('Favourites', '#', 'secondary')
            +icon('heart', 14)

        .menu__contacts
          p= contacts.phone
          p= contacts.email
          +socials(socialLinks)
