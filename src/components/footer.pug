footer.footer
  .container
    .footer__top
      nav.footer__links(aria-label="Навігація у футері")
        each column in footerColumns
          .footer__col
            h3.footer__heading= column.title
            ul
              each link in column.links
                li
                  a(href=link.href)= link.text

      .footer__subscribe
        h3.footer__heading Newsletter

        form.subscribe(action="#" method="post")
          .subscribe__fields
            label.visually-hidden(for="sub-email") Email для підписки
            input.subscribe__input#sub-email(type="email" placeholder="Your email address" required aria-describedby="sub-error")

            p.subscribe__error#sub-error Please enter a valid email address.

            label.subscribe__agree
              input(type="checkbox" name="agree" required)
              span I agree to the processing of personal data

            button.btn.btn--primary(type="submit") Subscribe

          p.subscribe__success Thanks! Half of our next journal issue is yours. ✉

    .footer__bottom
      p.footer__copy © #{new Date().getFullYear()} Keepsake studio. All rights reserved.
      +socials(socialLinks)

a.to-top(href="#top" aria-label="Догори")
  +icon('arrow-up', 18)
