nav#menu.c-menu(aria-label='Main menu')
  .c-menu__bar.o-container
    +logo
    a.c-icon-button(href='#!' aria-label='Close menu')
      +icon('close')
  .c-menu__body.o-container
    ul.c-menu__list
      each item in menu
        li
          a.c-menu__link(href=item.href)= item.title
    a.c-menu__phone(href=phone.href)= phone.text
    a.c-menu__order(href=phone.href) call to order
